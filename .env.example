# ==========================================
# MULTIMODAL AI COMPANION CONFIGURATION (.env)
# ==========================================

# Application Environment
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=8501
DEBUG=True

# Database Configuration (MySQL)
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=multimodal_companion_db

# Optional direct URL override (defaults to mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME})
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/multimodal_companion_db

# If MySQL service is stopped or unreachable during local development, fallback gracefully to SQLite
DB_FALLBACK_SQLITE=True

# AI Provider Configuration ("gemini" or "openai")
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection
CHAT_MODEL=gemini-2.0-flash
VISION_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# RAG & Document Ingestion
CHUNK_SIZE=800
CHUNK_OVERLAP=150
SIMILARITY_THRESHOLD=0.65
TOP_K_CHUNKS=4
MAX_UPLOAD_SIZE_MB=25

# Audio Configuration
TTS_ENGINE=edge-tts
TTS_VOICE=en-US-AriaNeural

# Security & Guardrails
EMOTION_SUPPORT_ENABLED=True
SAFETY_FILTER_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
